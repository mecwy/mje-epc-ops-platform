    "start": "node dist/main.js"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "@mje/contracts": "workspace:*",
    "@mje/domain": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "express": "5.2.1",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
