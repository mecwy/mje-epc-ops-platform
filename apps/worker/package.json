{
  "name": "@mje/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc && concurrently -k \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@mje/contracts": "workspace:*"
  },
  "exports": {
    "./weather-runtime": {
      "types": "./dist/weather-runtime.d.ts",
      "import": "./dist/weather-runtime.js"
    },
    "./weather-worker": {
      "types": "./dist/weather-worker.d.ts",
      "import": "./dist/weather-worker.js"
    },
    "./met-norway-transport": {
      "types": "./dist/met-norway-transport.d.ts",
      "import": "./dist/met-norway-transport.js"
    }
  }
}
