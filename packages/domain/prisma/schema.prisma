model PhotoEvidence {
  id                   String          @id @default(uuid()) @db.Uuid
  orgId                String          @db.Uuid
  org                  Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)
  updatedBy            String          @db.Uuid
  version              Int             @default(1)
  sha256               String          @db.Char(64)
  blobKey              String
  mediaType            String
  sizeBytes            BigInt
  deviceCapturedAt     DateTime?       @db.Timestamptz(6)
  receivedAt           DateTime        @default(now()) @db.Timestamptz(6)
  watermarkAssertion   Json?
  assignmentStatus     String          @default("PENDING")
  sourceDocumentId     String?         @db.Uuid
  sourceDocument       SourceDocument? @relation("PhotoEvidence_sourceDocumentId", fields: [orgId, sourceDocumentId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  EvidenceLink_photoId EvidenceLink[]  @relation("EvidenceLink_photoId")
  /// Site-report photo (U2.1 rule 8): project, site business day and source are set together
  /// (CHECK constraints in SQL). camera = in-app capture with a device fix; album = no uploader position.
  projectId            String?         @db.Uuid
  project              Project?        @relation("PhotoEvidence_project", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  businessDate         DateTime?       @db.Date
  source               String?
  captureLat           Decimal?        @db.Decimal(9, 6)
  captureLon           Decimal?        @db.Decimal(9, 6)
  captureAccuracyM     Decimal?        @db.Decimal(8, 2)
  captureFixAt         DateTime?       @db.Timestamptz(6)
  /// Claims read from the file (EXIF), never a verification. fileTakenLocal is the value as written.
  fileTakenAt          DateTime?       @db.Timestamptz(6)
  fileTakenLocal       String?
  fileGpsLat           Decimal?        @db.Decimal(9, 6)
  fileGpsLon           Decimal?        @db.Decimal(9, 6)
  thumbBlobKey         String?
  thumbMediaType       String?
  thumbSha256          String?         @db.Char(64)
  uploadedByAccountId  String?         @db.Uuid
  uploadedByAccount    LoginAccount?   @relation("PhotoEvidence_uploadedByAccount", fields: [orgId, uploadedByAccountId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  uploadedByPersonId   String?         @db.Uuid
  uploadedByPerson     Person?         @relation("PhotoEvidence_uploadedByPerson", fields: [orgId, uploadedByPersonId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  /// Upload order (identity); never the clock.
  seq                  BigInt          @default(autoincrement())

  @@unique([orgId, id])
  @@unique([orgId, sha256])
  @@index([orgId, projectId, businessDate, seq], map: "PhotoEvidence_project_day_idx")
}

model EvidenceLink {
  id                  String                @id @default(uuid()) @db.Uuid
