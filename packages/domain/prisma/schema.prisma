// ---------- A6a field roster, devices and entry (triggers, partial indexes, RLS in SQL) ----------
model Crew {
  id          String           @id @db.Uuid
  orgId       String           @db.Uuid
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  projectId   String           @db.Uuid
  project     Project          @relation("Crew_project", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  code        String
  name        String
  activeFrom  DateTime         @default(now()) @db.Timestamptz(6)
  /// Set once (trigger); the crew is never deleted.
  activeUntil DateTime?        @db.Timestamptz(6)
  createdBy   String           @db.Uuid
  creator     LoginAccount     @relation("Crew_createdBy", fields: [orgId, createdBy], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  assignments CrewAssignment[] @relation("CrewAssignment_crew")
  checkIns    WorkerCheckIn[]  @relation("WorkerCheckIn_crew")

  @@unique([orgId, id])
  @@unique([orgId, projectId, id])
  @@unique([orgId, projectId, code])
}

model ProjectRoster {
  id             String       @id @db.Uuid
  orgId          String       @db.Uuid
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  projectId      String       @db.Uuid
  project        Project      @relation("ProjectRoster_project", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  version        Int          @default(0)
  updatedAt      DateTime     @default(now()) @db.Timestamptz(6)
  /// Database time already observed in the project; never moves back (trigger). Deadline
  /// decisions refuse while the clock is behind it (design §5).
  clockHighWater DateTime?    @db.Timestamptz(6)

  @@unique([orgId, projectId])
}

/// Append-only half-open [validFrom, validUntil) interval; closed once at now() or later (trigger).
model CrewAssignment {
  id         String        @id @db.Uuid
  orgId      String        @db.Uuid
  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  projectId  String        @db.Uuid
  crewId     String        @db.Uuid
  crew       Crew          @relation("CrewAssignment_crew", fields: [orgId, projectId, crewId], references: [orgId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  personId   String        @db.Uuid
  person     Person        @relation("CrewAssignment_person", fields: [orgId, personId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  /// 'MEMBER' | 'FOREMAN' (CHECK constraint in SQL)
  role       String
  validFrom  DateTime      @db.Timestamptz(6)
  validUntil DateTime?     @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  createdBy  String        @db.Uuid
  creator    LoginAccount  @relation("CrewAssignment_createdBy", fields: [orgId, createdBy], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  closedBy   String?       @db.Uuid
  closer     LoginAccount? @relation("CrewAssignment_closedBy", fields: [orgId, closedBy], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orgId, projectId, personId, validFrom], map: "CrewAssignment_person_idx")
  @@index([orgId, crewId, validFrom], map: "CrewAssignment_crew_idx")
}

/// 128-bit project entry code; one active per project (partial unique index in SQL).
model FieldEntryCode {
  id        String        @id @db.Uuid
  orgId     String        @db.Uuid
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  projectId String        @db.Uuid
  project   Project       @relation("FieldEntryCode_project", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  code      String        @unique
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  createdBy String        @db.Uuid
  creator   LoginAccount  @relation("FieldEntryCode_createdBy", fields: [orgId, createdBy], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  retiredAt DateTime?     @db.Timestamptz(6)
  retiredBy String?       @db.Uuid
  retirer   LoginAccount? @relation("FieldEntryCode_retiredBy", fields: [orgId, retiredBy], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([orgId, id])
}

/// Browser-held secret for one Person on one project. Forward-only states (trigger);
/// one CONFIRMED per person and project (partial unique index in SQL).
model FieldDevice {
  id                   String                  @id @db.Uuid
  orgId                String                  @db.Uuid
  org                  Organization            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  projectId            String                  @db.Uuid
  project              Project                 @relation("FieldDevice_project", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  personId             String                  @db.Uuid
  person               Person                  @relation("FieldDevice_person", fields: [orgId, personId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  /// 'PENDING' | 'CONFIRMED' | 'REJECTED' | 'REVOKED' | 'EXPIRED'
  state                String
  tokenHash            String                  @unique @db.Char(64)
  prevTokenHash        String?                 @unique @db.Char(64)
  rotatedAt            DateTime?               @db.Timestamptz(6)
  generation           Int                     @default(1)
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  pendingUntil         DateTime                @db.Timestamptz(6)
  expiresAt            DateTime                @db.Timestamptz(6)
  memberUntil          DateTime?               @db.Timestamptz(6)
  lastSeenAt           DateTime                @db.Timestamptz(6)
  confirmedAt          DateTime?               @db.Timestamptz(6)
  confirmedByPersonId  String?                 @db.Uuid
  confirmedByPerson    Person?                 @relation("FieldDevice_confirmedByPerson", fields: [orgId, confirmedByPersonId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  confirmedByAccountId String?                 @db.Uuid
  confirmedByAccount   LoginAccount?           @relation("FieldDevice_confirmedByAccount", fields: [orgId, confirmedByAccountId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  confirmedByDeviceId  String?                 @db.Uuid
  confirmedByDevice    FieldDevice?            @relation("FieldDevice_confirmedByDevice", fields: [orgId, projectId, confirmedByDeviceId], references: [orgId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  confirmedDevices     FieldDevice[]           @relation("FieldDevice_confirmedByDevice")
  endedAt              DateTime?               @db.Timestamptz(6)
  endReason            String?
  version              Int                     @default(1)
  tokenHashes          FieldTokenHash[]        @relation("FieldTokenHash_device")
  challenges           FieldConfirmChallenge[] @relation("FieldConfirmChallenge_device")
  events               FieldDeviceEvent[]      @relation("FieldDeviceEvent_device")
  actorEvents          FieldDeviceEvent[]      @relation("FieldDeviceEvent_actorDevice")
  checkIns             WorkerCheckIn[]         @relation("WorkerCheckIn_device")
  selfies              FieldSelfie[]           @relation("FieldSelfie_device")

  @@unique([orgId, id])
  @@unique([orgId, projectId, id])
  @@index([orgId, projectId, personId], map: "FieldDevice_person_idx")
}

/// Every accepted token hash, never reused (append-only).
model FieldTokenHash {
  hash       String       @id @db.Char(64)
  orgId      String       @db.Uuid
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  deviceId   String       @db.Uuid
  device     FieldDevice  @relation("FieldTokenHash_device", fields: [orgId, deviceId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  acceptedAt DateTime     @default(now()) @db.Timestamptz(6)
}

/// Hashed 6-digit confirmation code; used or superseded once (trigger).
model FieldConfirmChallenge {
  id            String       @id @db.Uuid
  orgId         String       @db.Uuid
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  projectId     String       @db.Uuid
  personId      String       @db.Uuid
  person        Person       @relation("FieldConfirmChallenge_person", fields: [orgId, personId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  deviceId      String       @db.Uuid
  device        FieldDevice  @relation("FieldConfirmChallenge_device", fields: [orgId, projectId, deviceId], references: [orgId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  deviceVersion Int
  codeHash      String       @db.Char(64)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime     @db.Timestamptz(6)
  usedAt        DateTime?    @db.Timestamptz(6)
  supersededAt  DateTime?    @db.Timestamptz(6)

  @@index([orgId, deviceId], map: "FieldConfirmChallenge_device_idx")
}

model FieldPersonConfirm {
  id          String       @id @db.Uuid
