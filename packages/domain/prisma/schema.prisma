/// Lifecycle and refusal events; no coordinates, codes, tokens, hashes or names (append-only).
model FieldDeviceEvent {
  id              String        @id @db.Uuid
  orgId           String        @db.Uuid
  org             Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  projectId       String        @db.Uuid
  project         Project       @relation("FieldDeviceEvent_project", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  deviceId        String?       @db.Uuid
  device          FieldDevice?  @relation("FieldDeviceEvent_device", fields: [orgId, projectId, deviceId], references: [orgId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  personId        String?       @db.Uuid
  person          Person?       @relation("FieldDeviceEvent_person", fields: [orgId, personId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  kind            String
  reasonCode      String?
  at              DateTime      @default(now()) @db.Timestamptz(6)
  actorAccountId  String?       @db.Uuid
  actorAccount    LoginAccount? @relation("FieldDeviceEvent_actorAccount", fields: [orgId, actorAccountId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  actorPersonId   String?       @db.Uuid
  actorDeviceId   String?       @db.Uuid
  actorPerson     Person?       @relation("FieldDeviceEvent_actorPerson", fields: [orgId, actorPersonId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  actorDevice     FieldDevice?  @relation("FieldDeviceEvent_actorDevice", fields: [orgId, projectId, actorDeviceId], references: [orgId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  /// Append order (identity); never the clock.
  seq             BigInt        @default(autoincrement())
  /// Refused check-in attempts: distance from the site in 100 m buckets; never coordinates.
  distanceBucketM Int?
  /// Refused check-ins: the decision time they were judged at; the failed check-in limit counts
  /// by it (C29). Partial index in SQL.
  decidedAt       DateTime?     @db.Timestamptz(6)

  @@index([orgId, deviceId, seq], map: "FieldDeviceEvent_device_idx")
}

/// Pre-authentication throttle windows; salted bucket hashes, no tenant or personal data.
model FieldThrottle {
  bucket      String
  windowStart DateTime @db.Timestamptz(6)
  count       Int

  @@id([bucket, windowStart])
  @@index([windowStart])
}

model FieldThrottleSalt {
  day  DateTime @id @db.Date
  salt String
}

// ---------- A6b check-in and staged selfie (triggers, partial indexes, RLS in SQL) ----------
/// Geofence reference (append-only; the latest n is current).
model ProjectSiteReference {
  id        String          @id @db.Uuid
  orgId     String          @db.Uuid
  projectId String          @db.Uuid
  project   Project         @relation("ProjectSiteReference_project", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  n         Int
  lat       Decimal         @db.Decimal(9, 6)
  lon       Decimal         @db.Decimal(9, 6)
  radiusM   Int
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  createdBy String          @db.Uuid
  creator   LoginAccount    @relation("ProjectSiteReference_createdBy", fields: [orgId, createdBy], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  checkIns  WorkerCheckIn[] @relation("WorkerCheckIn_siteRef")

  @@unique([orgId, projectId, n])
}

/// Selfie switch and PM proxy window (append-only; no row = selfie off, 7 days).
model ProjectFieldSetting {
  id            String       @id @db.Uuid
  orgId         String       @db.Uuid
  projectId     String       @db.Uuid
  project       Project      @relation("ProjectFieldSetting_project", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  n             Int
  selfieEnabled Boolean
  pmProxyDays   Int
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  createdBy     String       @db.Uuid
  creator       LoginAccount @relation("ProjectFieldSetting_createdBy", fields: [orgId, createdBy], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([orgId, projectId, n])
}

/// Per-day field sequence (submission boundary); only moves forward (trigger).
model FieldDay {
  id           String   @id @db.Uuid
  orgId        String   @db.Uuid
  projectId    String   @db.Uuid
  project      Project  @relation("FieldDay_project", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  businessDate DateTime @db.Date
  lastSeq      BigInt

  @@unique([orgId, projectId, businessDate])
}

/// "P was on site at T" (a claim; never hours or headcount). Append-only; void columns once
/// (trigger); one non-voided per (project, person, businessDate) (partial unique index in SQL).
model WorkerCheckIn {
  id              String                @id @db.Uuid
  orgId           String                @db.Uuid
  projectId       String                @db.Uuid
  project         Project               @relation("WorkerCheckIn_project", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  personId        String                @db.Uuid
  person          Person                @relation("WorkerCheckIn_person", fields: [orgId, personId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  businessDate    DateTime              @db.Date
  siteTimezone    String
  /// 'SELF' | 'FOREMAN_PROXY' | 'PM_PROXY'
  kind            String
  crewId          String?               @db.Uuid
  crew            Crew?                 @relation("WorkerCheckIn_crew", fields: [orgId, projectId, crewId], references: [orgId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  crewAttribution String
  deviceId        String?               @db.Uuid
  device          FieldDevice?          @relation("WorkerCheckIn_device", fields: [orgId, projectId, deviceId], references: [orgId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  actorPersonId   String                @db.Uuid
  actorPerson     Person                @relation("WorkerCheckIn_actorPerson", fields: [orgId, actorPersonId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  actorAccountId  String?               @db.Uuid
  actorAccount    LoginAccount?         @relation("WorkerCheckIn_actorAccount", fields: [orgId, actorAccountId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  occurredAt      DateTime?             @db.Timestamptz(6)
  timePrecision   String
  fixAt           DateTime?             @db.Timestamptz(6)
  deviceSentAt    DateTime?             @db.Timestamptz(6)
  receivedAt      DateTime              @db.Timestamptz(6)
  recordedAt      DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  clockSkewMs     Int?
  lat             Decimal?              @db.Decimal(9, 6)
  lon             Decimal?              @db.Decimal(9, 6)
  accuracyM       Decimal?              @db.Decimal(8, 2)
  distanceM       Int?
  siteRefN        Int?
  siteRef         ProjectSiteReference? @relation("WorkerCheckIn_siteRef", fields: [orgId, projectId, siteRefN], references: [orgId, projectId, n], onDelete: Restrict, onUpdate: NoAction)
  actorLat        Decimal?              @db.Decimal(9, 6)
  actorLon        Decimal?              @db.Decimal(9, 6)
  actorAccuracyM  Decimal?              @db.Decimal(8, 2)
  actorFixAt      DateTime?             @db.Timestamptz(6)
  actorDistanceM  Int?
  source          String?
  reason          String?
  flags           String[]              @default([])
  daySeq          BigInt
  voidedAt        DateTime?             @db.Timestamptz(6)
  voidedBy        String?               @db.Uuid
  voider          LoginAccount?         @relation("WorkerCheckIn_voidedBy", fields: [orgId, voidedBy], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  voidReason      String?
  voidSeq         BigInt?
  selfie          CheckInSelfie[]       @relation("CheckInSelfie_checkIn")

  @@unique([orgId, id])
  @@unique([orgId, projectId, id, personId])
  @@index([orgId, projectId, businessDate], map: "WorkerCheckIn_day_idx")
  @@index([orgId, personId, businessDate], map: "WorkerCheckIn_person_day_idx")
}

/// Staged selfie; forward-only states (trigger): STAGED -> ATTACHED | DELETING -> DELETED.
model FieldSelfie {
  id         String          @id @db.Uuid
  orgId      String          @db.Uuid
  projectId  String          @db.Uuid
  personId   String          @db.Uuid
  person     Person          @relation("FieldSelfie_person", fields: [orgId, personId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  deviceId   String          @db.Uuid
  device     FieldDevice     @relation("FieldSelfie_device", fields: [orgId, projectId, deviceId], references: [orgId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  sha256     String          @db.Char(64)
  blobKey    String
  mediaType  String
  sizeBytes  Int
  state      String
  createdAt  DateTime        @db.Timestamptz(6)
  expiresAt  DateTime        @db.Timestamptz(6)
  attachedAt DateTime?       @db.Timestamptz(6)
  claimedAt  DateTime?       @db.Timestamptz(6)
  deletedAt  DateTime?       @db.Timestamptz(6)
  checkIns   CheckInSelfie[] @relation("CheckInSelfie_selfie")

  @@unique([orgId, projectId, id, personId])
  @@index([orgId, state, expiresAt], map: "FieldSelfie_state_idx")
}

/// One selfie per check-in and one check-in per selfie, same project and person (append-only).
model CheckInSelfie {
  id        String        @id @db.Uuid
  orgId     String        @db.Uuid
  projectId String        @db.Uuid
  personId  String        @db.Uuid
  checkInId String        @unique @db.Uuid
  checkIn   WorkerCheckIn @relation("CheckInSelfie_checkIn", fields: [orgId, projectId, checkInId, personId], references: [orgId, projectId, id, personId], onDelete: Restrict, onUpdate: NoAction)
  selfieId  String        @unique @db.Uuid
  selfie    FieldSelfie   @relation("CheckInSelfie_selfie", fields: [orgId, projectId, selfieId, personId], references: [orgId, projectId, id, personId], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
}

// ---------- A6c foreman quantity reports and adoption (triggers, CHECKs, RLS in SQL) ----------
/// One header per (project, business day, crew); currentN moves forward by one (trigger).
model ForemanReport {
  id           String                  @id @db.Uuid
