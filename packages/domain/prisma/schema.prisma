  onDate         DateTime     @db.Date
  actorAccountId String       @db.Uuid
  actorAccount   LoginAccount @relation("IssueTransition_account", fields: [orgId, actorAccountId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  actorPersonId  String       @db.Uuid
  actorPerson    Person       @relation("IssueTransition_person", fields: [orgId, actorPersonId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  /// Application order (identity); never the clock.
  seq            BigInt       @default(autoincrement())

  @@unique([orgId, id])
  @@index([orgId, issueId, onDate, seq], map: "IssueTransition_issue_idx")
}

