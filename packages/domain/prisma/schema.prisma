  updatedBy           String                @db.Uuid
  version             Int                   @default(1)
  coverageDescription String
  photoId             String                @db.Uuid
  photo               PhotoEvidence         @relation("EvidenceLink_photoId", fields: [orgId, photoId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  taskId              String?               @db.Uuid
  task                DailyTask?            @relation("EvidenceLink_taskId", fields: [orgId, taskId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
