// Phase 0 executable schema sketch; not a production authorization model.
generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum PricingType {
  UNKNOWN
  LUMP_SUM
  TIME_AND_MATERIAL
  UNIT_PRICE
  REIMBURSABLE
}

enum PlanKind {
  QUOTE_ASSUMPTION
  APPROVED_BASELINE
  ROLLING_PLAN
  CONTRACT_MINIMUM
  RECOVERY_PLAN
}

enum VerificationScope {
  IDENTITY
  PRESENCE
  LABOR
  OUTPUT
}

enum VerificationResult {
  NOT_CHECKED
  CONFIRMED_AT_POINT
  CONFIRMED_INTERVAL
  CONTRADICTED
  INCONCLUSIVE
}

enum TimePrecision {
  INTERVAL
  NET_MINUTES
  UNKNOWN
}

enum LaborKind {
  DIRECT
  SUPPORT
  REWORK
  WAITING
  OFFSITE
  TRAVEL
  BREAK
  UNALLOCATED
  UNKNOWN
}

enum DailyCloseState {
  EXPECTED
  DRAFT
  SUBMITTED
  RETURNED
  REVIEWED
  CLOSED
}

enum IssueState {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLUTION_SUBMITTED
  VERIFIED_CLOSED
  REOPENED
  /// Closed by the project manager; not a verification.
  CLOSED
}

enum RevisionState {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

model Organization {
  OpportunityRecord_org          OpportunityRecord[]          @relation("OpportunityRecord_org")
  OpportunityRecordPerson_org    OpportunityRecordPerson[]    @relation("OpportunityRecordPerson_org")
  OpportunityRecordCompany_org   OpportunityRecordCompany[]   @relation("OpportunityRecordCompany_org")
  OpportunityRecordSource_org    OpportunityRecordSource[]    @relation("OpportunityRecordSource_org")
  OpportunityGrant_org           OpportunityGrant[]           @relation("OpportunityGrant_org")
  OpportunityGrantRevocation_org OpportunityGrantRevocation[] @relation("OpportunityGrantRevocation_org")
  ContractLine_org               ContractLine[]               @relation("ContractLine_org")
  ContractLineRevision_org       ContractLineRevision[]       @relation("ContractLineRevision_org")
  ContractScopeVersion_org       ContractScopeVersion[]       @relation("ContractScopeVersion_org")
  ContractAttention_org          ContractAttention[]          @relation("ContractAttention_org")
  ContractAttentionRead_org      ContractAttentionRead[]      @relation("ContractAttentionRead_org")

  ContractGrant_org            ContractGrant[]               @relation("ContractGrant_org")
  ContractGrantRevocation_org  ContractGrantRevocation[]     @relation("ContractGrantRevocation_org")
  Contract_org                 Contract[]                    @relation("Contract_org")
  ContractRevision_org         ContractRevision[]            @relation("ContractRevision_org")
  ContractRevisionSource_org   ContractRevisionSource[]      @relation("ContractRevisionSource_org")
  id                           String                        @id @default(uuid()) @db.Uuid
  name                         String
  governanceRef                String?
  createdAt                    DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                      @updatedAt @db.Timestamptz(6)
  updatedBy                    String                        @db.Uuid
  version                      Int                           @default(1)
  alphaDraftRows               AlphaDraft[]
  reportDrafts                 DailyReportDraft[]
  planVersions                 PlanVersion[]
  planDrafts                   PlanDraft[]
  reportItems                  ReportItem[]
  issueNotes                   IssueNote[]
  issueTransitions             IssueTransition[]
  lagDismissals                LagDismissal[]
  companyRows                  Company[]
  customerRows                 Customer[]
  opportunityRows              Opportunity[]
  projectRows                  Project[]
  siteRows                     Site[]
  projectSiteRows              ProjectSite[]
  areaRows                     Area[]
  contractScopeRows            ContractScope[]
  workPackageRows              WorkPackage[]
  personRows                   Person[]
  loginAccountRows             LoginAccount[]
  membershipRows               Membership[]
  personAliasRows              PersonAlias[]
  personAssignmentRows         PersonAssignment[]
  workforcePlanRows            WorkforcePlan[]
  sourceDocumentRows           SourceDocument[]
  sourceAssertionRows          SourceAssertion[]
  reportingBundleRows          ReportingBundle[]
  attendanceClaimRows          AttendanceClaim[]
  presenceVerificationRows     PresenceVerification[]
  dailyTaskRows                DailyTask[]
  laborEntryRows               LaborEntry[]
  laborAllocationRows          LaborAllocation[]
  dailyQuantityPlanRows        DailyQuantityPlan[]
  quantityProgressRows         QuantityProgress[]
  inspectionRows               Inspection[]
  acceptanceRows               Acceptance[]
  photoEvidenceRows            PhotoEvidence[]
  evidenceLinkRows             EvidenceLink[]
  issueRows                    Issue[]
  dailyCloseRows               DailyClose[]
  revisionRows                 Revision[]
  revisionEventRows            RevisionEvent[]
  dailyFactLinkRows            DailyFactLink[]
  chargeableLaborReferenceRows ChargeableLaborReference[]
  idempotencyRecordRows        IdempotencyRecord[]
  outboxEventRows              OutboxEvent[]
  auditLogRows                 AuditLog[]
  crewRows                     Crew[]
  projectRosterRows            ProjectRoster[]
  crewAssignmentRows           CrewAssignment[]
  fieldEntryCodeRows           FieldEntryCode[]
  fieldDeviceRows              FieldDevice[]
  fieldTokenHashRows           FieldTokenHash[]
  fieldConfirmChallengeRows    FieldConfirmChallenge[]
  fieldPersonConfirmRows       FieldPersonConfirm[]
  fieldDeviceEventRows         FieldDeviceEvent[]
  projectStatusUpdates         ProjectStatusUpdate[]
  projectStatusNotes           ProjectStatusNote[]
  reportingExpectations        ReportingExpectationVersion[]
}

model Company {
  OpportunityRecordCompany_companyId OpportunityRecordCompany[] @relation("OpportunityRecordCompany_companyId")
  ContractRevision_counterparty      ContractRevision[]         @relation("ContractRevision_counterparty")
  ContractRevision_selfParty         ContractRevision[]         @relation("ContractRevision_selfParty")

  id                     String          @id @default(uuid()) @db.Uuid
  orgId                  String          @db.Uuid
  org                    Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt              DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(6)
  updatedBy              String          @db.Uuid
  version                Int             @default(1)
  name                   String
  kind                   String // VENDOR / EMPLOYER / CUSTOMER / OTHER; not a legal related-party conclusion
  Customer_companyId     Customer[]      @relation("Customer_companyId")
  ContractScope_vendorId ContractScope[] @relation("ContractScope_vendorId")
  Person_employerId      Person[]        @relation("Person_employerId")

  @@unique([orgId, id])
}

model Customer {
  id                     String        @id @default(uuid()) @db.Uuid
  orgId                  String        @db.Uuid
  org                    Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(6)
  updatedBy              String        @db.Uuid
  version                Int           @default(1)
  name                   String
  companyId              String?       @db.Uuid
  company                Company?      @relation("Customer_companyId", fields: [orgId, companyId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  Opportunity_customerId Opportunity[] @relation("Opportunity_customerId")
  Project_customerId     Project[]     @relation("Project_customerId")

  @@unique([orgId, id])
}

model Opportunity {
  OpportunityRecord_opportunityId OpportunityRecord[] @relation("OpportunityRecord_opportunityId")
  OpportunityGrant_opportunityId  OpportunityGrant[]  @relation("OpportunityGrant_opportunityId")
  id                              String              @id @default(uuid()) @db.Uuid
  orgId                           String              @db.Uuid
  org                             Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt                       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime            @updatedAt @db.Timestamptz(6)
  updatedBy                       String              @db.Uuid
  version                         Int                 @default(1)
  code                            String
  stage                           String
  customerId                      String?             @db.Uuid
  customer                        Customer?           @relation("Opportunity_customerId", fields: [orgId, customerId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  Project_opportunityId           Project[]           @relation("Project_opportunityId")
  PersonAssignment_opportunityId  PersonAssignment[]  @relation("PersonAssignment_opportunityId")
  DailyTask_opportunityId         DailyTask[]         @relation("DailyTask_opportunityId")

  @@unique([orgId, id])
  @@unique([orgId, code])
}

model Project {
  ContractGrant_project                   ContractGrant[]               @relation("ContractGrant_project")
  id                                      String                        @id @default(uuid()) @db.Uuid
  orgId                                   String                        @db.Uuid
  org                                     Organization                  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt                               DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                               DateTime                      @updatedAt @db.Timestamptz(6)
  updatedBy                               String                        @db.Uuid
  version                                 Int                           @default(1)
  code                                    String
  name                                    String
  timezone                                String
  status                                  String
  customerId                              String?                       @db.Uuid
  customer                                Customer?                     @relation("Project_customerId", fields: [orgId, customerId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  opportunityId                           String?                       @db.Uuid
  opportunity                             Opportunity?                  @relation("Project_opportunityId", fields: [orgId, opportunityId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  ProjectSite_projectId                   ProjectSite[]                 @relation("ProjectSite_projectId")
  ContractScope_projectId                 ContractScope[]               @relation("ContractScope_projectId")
  WorkPackage_projectId                   WorkPackage[]                 @relation("WorkPackage_projectId")
  Membership_projectId                    Membership[]                  @relation("Membership_projectId")
  PersonAssignment_projectId              PersonAssignment[]            @relation("PersonAssignment_projectId")
  WorkforcePlan_projectId                 WorkforcePlan[]               @relation("WorkforcePlan_projectId")
  ReportingBundle_titleProjectCandidateId ReportingBundle[]             @relation("ReportingBundle_titleProjectCandidateId")
  DailyTask_projectId                     DailyTask[]                   @relation("DailyTask_projectId")
  Issue_projectId                         Issue[]                       @relation("Issue_projectId")
  DailyClose_projectId                    DailyClose[]                  @relation("DailyClose_projectId")
  PlanVersion_project                     PlanVersion[]                 @relation("PlanVersion_project")
  PlanDraft_project                       PlanDraft[]                   @relation("PlanDraft_project")
  ReportItem_project                      ReportItem[]                  @relation("ReportItem_project")
  LagDismissal_project                    LagDismissal[]                @relation("LagDismissal_project")
  PhotoEvidence_project                   PhotoEvidence[]               @relation("PhotoEvidence_project")
  Crew_project                            Crew[]                        @relation("Crew_project")
  ProjectRoster_project                   ProjectRoster[]               @relation("ProjectRoster_project")
  FieldEntryCode_project                  FieldEntryCode[]              @relation("FieldEntryCode_project")
  FieldDevice_project                     FieldDevice[]                 @relation("FieldDevice_project")
  FieldPersonConfirm_project              FieldPersonConfirm[]          @relation("FieldPersonConfirm_project")
  FieldDeviceEvent_project                FieldDeviceEvent[]            @relation("FieldDeviceEvent_project")
  ProjectSiteReference_project            ProjectSiteReference[]        @relation("ProjectSiteReference_project")
  ProjectFieldSetting_project             ProjectFieldSetting[]         @relation("ProjectFieldSetting_project")
  FieldDay_project                        FieldDay[]                    @relation("FieldDay_project")
  WorkerCheckIn_project                   WorkerCheckIn[]               @relation("WorkerCheckIn_project")
  projectStatusUpdates                    ProjectStatusUpdate[]
  projectStatusNotes                      ProjectStatusNote[]
  primaryWorkItemKey                      String?
  region                                  String?
  projectType                             String?
  reportingExpectations                   ReportingExpectationVersion[]

  @@unique([orgId, id])
  @@unique([orgId, code])
}

model Site {
  id                 String        @id @default(uuid()) @db.Uuid
  orgId              String        @db.Uuid
  org                Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)
  updatedBy          String        @db.Uuid
  version            Int           @default(1)
  code               String
  name               String
  timezone           String
  ProjectSite_siteId ProjectSite[] @relation("ProjectSite_siteId")
  Area_siteId        Area[]        @relation("Area_siteId")

  @@unique([orgId, id])
  @@unique([orgId, code])
}

model ProjectSite {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)
  updatedBy String       @db.Uuid
  version   Int          @default(1)
  projectId String       @db.Uuid
  project   Project      @relation("ProjectSite_projectId", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  siteId    String       @db.Uuid
  site      Site         @relation("ProjectSite_siteId", fields: [orgId, siteId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([orgId, id])
  @@unique([orgId, projectId, siteId])
}

model Area {
  id                 String        @id @default(uuid()) @db.Uuid
  orgId              String        @db.Uuid
  org                Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)
  updatedBy          String        @db.Uuid
  version            Int           @default(1)
  code               String
  name               String
  siteId             String        @db.Uuid
  site               Site          @relation("Area_siteId", fields: [orgId, siteId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  WorkPackage_areaId WorkPackage[] @relation("WorkPackage_areaId")
  DailyTask_areaId   DailyTask[]   @relation("DailyTask_areaId")
  DailyClose_areaId  DailyClose[]  @relation("DailyClose_areaId")

  @@unique([orgId, id])
}

model ContractScope {
  contractId                 String?                @db.Uuid
  contractLineId             String?                @db.Uuid
  line                       ContractLine?          @relation("ContractScope_line", fields: [orgId, contractId, contractLineId], references: [orgId, contractId, id], onDelete: Restrict, onUpdate: NoAction)
  ContractScopeVersion_scope ContractScopeVersion[] @relation("ContractScopeVersion_scope")

  id                                       String                     @id @default(uuid()) @db.Uuid
  orgId                                    String                     @db.Uuid
  org                                      Organization               @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt                                DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                                DateTime                   @updatedAt @db.Timestamptz(6)
  updatedBy                                String                     @db.Uuid
  version                                  Int                        @default(1)
  code                                     String
  pricingType                              PricingType
  currency                                 String?                    @db.Char(3)
  amount                                   Decimal?                   @db.Decimal(20, 4)
  policyVersion                            String?
  projectId                                String                     @db.Uuid
  project                                  Project                    @relation("ContractScope_projectId", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  vendorId                                 String?                    @db.Uuid
  vendor                                   Company?                   @relation("ContractScope_vendorId", fields: [orgId, vendorId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  WorkPackage_contractScopeId              WorkPackage[]              @relation("WorkPackage_contractScopeId")
  ChargeableLaborReference_contractScopeId ChargeableLaborReference[] @relation("ChargeableLaborReference_contractScopeId")

  @@unique([orgId, contractId, contractLineId, id])
  @@unique([orgId, contractLineId, projectId])
  @@unique([orgId, id])
}

model WorkPackage {
  id                              String              @id @default(uuid()) @db.Uuid
  orgId                           String              @db.Uuid
  org                             Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt                       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime            @updatedAt @db.Timestamptz(6)
  updatedBy                       String              @db.Uuid
  version                         Int                 @default(1)
  code                            String
  name                            String
  uom                             String?
  designQuantity                  Decimal?            @db.Decimal(20, 6)
  baselineVersion                 String?
  projectId                       String              @db.Uuid
  project                         Project             @relation("WorkPackage_projectId", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  areaId                          String?             @db.Uuid
  area                            Area?               @relation("WorkPackage_areaId", fields: [orgId, areaId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  contractScopeId                 String?             @db.Uuid
  contractScope                   ContractScope?      @relation("WorkPackage_contractScopeId", fields: [orgId, contractScopeId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  WorkforcePlan_workPackageId     WorkforcePlan[]     @relation("WorkforcePlan_workPackageId")
  DailyTask_workPackageId         DailyTask[]         @relation("DailyTask_workPackageId")
  DailyQuantityPlan_workPackageId DailyQuantityPlan[] @relation("DailyQuantityPlan_workPackageId")

  @@unique([orgId, id])
}

model Person {
  OpportunityRecord_recordedByPersonId OpportunityRecord[]       @relation("OpportunityRecord_recordedByPersonId")
  OpportunityRecordPerson_personId     OpportunityRecordPerson[] @relation("OpportunityRecordPerson_personId")
  OpportunityGrant_personId            OpportunityGrant[]        @relation("OpportunityGrant_personId")
  OpportunityGrant_representedPersonId OpportunityGrant[]        @relation("OpportunityGrant_representedPersonId")
  ContractScopeVersion_actorPerson     ContractScopeVersion[]    @relation("ContractScopeVersion_actorPerson")
  ContractAttention_causer             ContractAttention[]       @relation("ContractAttention_causer")
  ContractAttentionRead_actorPerson    ContractAttentionRead[]   @relation("ContractAttentionRead_actorPerson")

  ContractGrant_person                  ContractGrant[]         @relation("ContractGrant_person")
  ContractGrant_represented             ContractGrant[]         @relation("ContractGrant_represented")
  ContractRevision_informationOwner     ContractRevision[]      @relation("ContractRevision_informationOwner")
  ContractRevision_registrarPerson      ContractRevision[]      @relation("ContractRevision_registrarPerson")
  id                                    String                  @id @default(uuid()) @db.Uuid
  orgId                                 String                  @db.Uuid
  org                                   Organization            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt                             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                             DateTime                @updatedAt @db.Timestamptz(6)
  updatedBy                             String                  @db.Uuid
  version                               Int                     @default(1)
  displayName                           String
  identityStatus                        String                  @default("PROVISIONAL")
  // No government ID originals or face templates in this sketch.
  employerId                            String?                 @db.Uuid
  employer                              Company?                @relation("Person_employerId", fields: [orgId, employerId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  LoginAccount_personId                 LoginAccount[]          @relation("LoginAccount_personId")
  PersonAlias_personId                  PersonAlias[]           @relation("PersonAlias_personId")
  PersonAssignment_personId             PersonAssignment[]      @relation("PersonAssignment_personId")
  AttendanceClaim_personId              AttendanceClaim[]       @relation("AttendanceClaim_personId")
  PresenceVerification_reviewerPersonId PresenceVerification[]  @relation("PresenceVerification_reviewerPersonId")
  PresenceVerification_subjectPersonId  PresenceVerification[]  @relation("PresenceVerification_subjectPersonId")
  LaborEntry_personId                   LaborEntry[]            @relation("LaborEntry_personId")
  Inspection_inspectorPersonId          Inspection[]            @relation("Inspection_inspectorPersonId")
  Acceptance_approverPersonId           Acceptance[]            @relation("Acceptance_approverPersonId")
  Issue_ownerPersonId                   Issue[]                 @relation("Issue_ownerPersonId")
  IssueNote_authorPersonId              IssueNote[]             @relation("IssueNote_person")
  IssueTransition_actorPersonId         IssueTransition[]       @relation("IssueTransition_person")
  PhotoEvidence_uploadedByPersonId      PhotoEvidence[]         @relation("PhotoEvidence_uploadedByPerson")
  DailyClose_responsiblePersonId        DailyClose[]            @relation("DailyClose_responsiblePersonId")
  DailyClose_delegatePersonId           DailyClose[]            @relation("DailyClose_delegatePersonId")
  CrewAssignment_person                 CrewAssignment[]        @relation("CrewAssignment_person")
  FieldDevice_person                    FieldDevice[]           @relation("FieldDevice_person")
  FieldDevice_confirmedByPerson         FieldDevice[]           @relation("FieldDevice_confirmedByPerson")
  FieldConfirmChallenge_person          FieldConfirmChallenge[] @relation("FieldConfirmChallenge_person")
  FieldPersonConfirm_person             FieldPersonConfirm[]    @relation("FieldPersonConfirm_person")
  FieldDeviceEvent_person               FieldDeviceEvent[]      @relation("FieldDeviceEvent_person")
  FieldDeviceEvent_actorPerson          FieldDeviceEvent[]      @relation("FieldDeviceEvent_actorPerson")
  WorkerCheckIn_person                  WorkerCheckIn[]         @relation("WorkerCheckIn_person")
  WorkerCheckIn_actorPerson             WorkerCheckIn[]         @relation("WorkerCheckIn_actorPerson")
  FieldSelfie_person                    FieldSelfie[]           @relation("FieldSelfie_person")
  ForemanReportRevision_byPerson        ForemanReportRevision[] @relation("ForemanReportRevision_byPerson")
  projectStatusUpdates                  ProjectStatusUpdate[]   @relation("ProjectStatusUpdatePerson")
  projectStatusNotes                    ProjectStatusNote[]     @relation("ProjectStatusNotePerson")

  @@unique([orgId, id])
}

model LoginAccount {
  OpportunityRecord_recordedByAccountId OpportunityRecord[]          @relation("OpportunityRecord_recordedByAccountId")
  OpportunityGrant_accountId            OpportunityGrant[]           @relation("OpportunityGrant_accountId")
  OpportunityGrant_grantedBy            OpportunityGrant[]           @relation("OpportunityGrant_grantedBy")
  OpportunityGrantRevocation_revokedBy  OpportunityGrantRevocation[] @relation("OpportunityGrantRevocation_revokedBy")
  ContractScopeVersion_actor            ContractScopeVersion[]       @relation("ContractScopeVersion_actor")
  ContractAttentionRead_actor           ContractAttentionRead[]      @relation("ContractAttentionRead_actor")

  ContractGrant_account           ContractGrant[]               @relation("ContractGrant_account")
  ContractGrant_grantor           ContractGrant[]               @relation("ContractGrant_grantor")
  ContractGrantRevocation_revoker ContractGrantRevocation[]     @relation("ContractGrantRevocation_revoker")
  Contract_creator                Contract[]                    @relation("Contract_creator")
  ContractRevision_registrar      ContractRevision[]            @relation("ContractRevision_registrar")
  id                              String                        @id @default(uuid()) @db.Uuid
  orgId                           String                        @db.Uuid
  org                             Organization                  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt                       DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime                      @updatedAt @db.Timestamptz(6)
  updatedBy                       String                        @db.Uuid
  version                         Int                           @default(1)
  entraTenantId                   String
  entraObjectId                   String
  active                          Boolean                       @default(true)
  personId                        String?                       @db.Uuid
  /// Bumped by database triggers on Membership writes and on active/personId changes (ADR-0003 D5).
  authzVersion                    Int                           @default(1)
  person                          Person?                       @relation("LoginAccount_personId", fields: [orgId, personId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  alphaDraftUpdates               AlphaDraft[]
  reportDraftUpdates              DailyReportDraft[]            @relation("DailyReportDraft_actor")
  planVersionConfirms             PlanVersion[]                 @relation("PlanVersion_actor")
  planDraftUpdates                PlanDraft[]                   @relation("PlanDraft_actor")
  issueCloses                     Issue[]                       @relation("Issue_closedBy")
  issueNotes                      IssueNote[]                   @relation("IssueNote_account")
  issueTransitions                IssueTransition[]             @relation("IssueTransition_account")
  lagDismissals                   LagDismissal[]                @relation("LagDismissal_actor")
  photoUploads                    PhotoEvidence[]               @relation("PhotoEvidence_uploadedByAccount")
  photoLinkSupersedes             EvidenceLink[]                @relation("EvidenceLink_supersededBy")
  Membership_accountId            Membership[]                  @relation("Membership_accountId")
  crewCreates                     Crew[]                        @relation("Crew_createdBy")
  assignmentCreates               CrewAssignment[]              @relation("CrewAssignment_createdBy")
  assignmentCloses                CrewAssignment[]              @relation("CrewAssignment_closedBy")
  entryCodeCreates                FieldEntryCode[]              @relation("FieldEntryCode_createdBy")
  entryCodeRetires                FieldEntryCode[]              @relation("FieldEntryCode_retiredBy")
  deviceConfirms                  FieldDevice[]                 @relation("FieldDevice_confirmedByAccount")
  fieldDeviceEvents               FieldDeviceEvent[]            @relation("FieldDeviceEvent_actorAccount")
  siteReferences                  ProjectSiteReference[]        @relation("ProjectSiteReference_createdBy")
  fieldSettings                   ProjectFieldSetting[]         @relation("ProjectFieldSetting_createdBy")
  proxyCheckIns                   WorkerCheckIn[]               @relation("WorkerCheckIn_actorAccount")
  voidedCheckIns                  WorkerCheckIn[]               @relation("WorkerCheckIn_voidedBy")
  foremanAdoptions                ForemanAdoption[]             @relation("ForemanAdoption_byAccount")
  projectStatusUpdates            ProjectStatusUpdate[]         @relation("ProjectStatusUpdateAccount")
  projectStatusNotes              ProjectStatusNote[]           @relation("ProjectStatusNoteAccount")
  reportingExpectations           ReportingExpectationVersion[]

  @@unique([orgId, id])
  @@unique([orgId, entraTenantId, entraObjectId])
}

model Membership {
  OpportunityGrant_membershipId OpportunityGrant[] @relation("OpportunityGrant_membershipId")
  ContractGrant_membership      ContractGrant[]    @relation("ContractGrant_membership")
  id                            String             @id @default(uuid()) @db.Uuid
  orgId                         String             @db.Uuid
  org                           Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt                     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime           @updatedAt @db.Timestamptz(6)
  updatedBy                     String             @db.Uuid
  version                       Int                @default(1)
  role                          String
  activeFrom                    DateTime           @db.Timestamptz(6)
  activeUntil                   DateTime?          @db.Timestamptz(6)
  accountId                     String             @db.Uuid
  account                       LoginAccount       @relation("Membership_accountId", fields: [orgId, accountId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  projectId                     String?            @db.Uuid
  project                       Project?           @relation("Membership_projectId", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([orgId, id])
}

model PersonAlias {
  id                 String       @id @default(uuid()) @db.Uuid
  orgId              String       @db.Uuid
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)
  updatedBy          String       @db.Uuid
  version            Int          @default(1)
  value              String
  namespace          String
  verificationStatus String       @default("UNVERIFIED")
  personId           String       @db.Uuid
