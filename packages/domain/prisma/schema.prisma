  orgId       String       @db.Uuid
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  projectId   String       @db.Uuid
  project     Project      @relation("FieldPersonConfirm_project", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  personId    String       @db.Uuid
  person      Person       @relation("FieldPersonConfirm_person", fields: [orgId, personId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  failures    Int          @default(0)
  windowStart DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([orgId, projectId, personId])
