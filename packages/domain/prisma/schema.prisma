  inspection          Inspection?           @relation("EvidenceLink_inspectionId", fields: [orgId, inspectionId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  /// Site-report link (businessDate set): exactly one of workItemKey / issueId. Append-only: a
  /// change supersedes the current row once (trigger) and inserts a new one.
  businessDate        DateTime?             @db.Date
  workItemKey         String?
  issueId             String?               @db.Uuid
  issue               Issue?                @relation("EvidenceLink_issue", fields: [orgId, issueId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  supersededAt        DateTime?             @db.Timestamptz(6)
  supersededBy        String?               @db.Uuid
  superseder          LoginAccount?         @relation("EvidenceLink_supersededBy", fields: [orgId, supersededBy], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  /// Link order (identity); never the clock.
  seq                 BigInt                @default(autoincrement())

  @@unique([orgId, id])
  @@index([orgId, photoId, seq], map: "EvidenceLink_photo_idx")
}

model Issue {
  id            String            @id @default(uuid()) @db.Uuid
  orgId         String            @db.Uuid
  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(6)
  updatedBy     String            @db.Uuid
  version       Int               @default(1)
  kind          String
  state         IssueState        @default(OPEN)
  summary       String
  dueAt         DateTime?         @db.Timestamptz(6)
  resolution    String?
  // Signals never automatically imply fraud.
  projectId     String?           @db.Uuid
  project       Project?          @relation("Issue_projectId", fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  taskId        String?           @db.Uuid
  task          DailyTask?        @relation("Issue_taskId", fields: [orgId, taskId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  sourceId      String?           @db.Uuid
  source        SourceAssertion?  @relation("Issue_sourceId", fields: [orgId, sourceId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  ownerPersonId String?           @db.Uuid
  ownerPerson   Person?           @relation("Issue_ownerPersonId", fields: [orgId, ownerPersonId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  /// One of the 8 escalation categories (CHECK constraint in SQL); escalate requires it.
  category      String?
  escalate      Boolean           @default(false)
  /// Needs expert confirmation; the project manager cannot close it.
  controlled    Boolean           @default(false)
  workItemKey   String?
  /// Site business dates.
  createdOn     DateTime?         @db.Date
  dueOn         DateTime?         @db.Date
  closedOn      DateTime?         @db.Date
  closedBy      String?           @db.Uuid
  closer        LoginAccount?     @relation("Issue_closedBy", fields: [orgId, closedBy], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  /// Creation order (identity); never the clock.
  seq           BigInt            @default(autoincrement())
  notes         IssueNote[]       @relation("IssueNote_issue")
  transitions   IssueTransition[] @relation("IssueTransition_issue")
  photoLinks    EvidenceLink[]    @relation("EvidenceLink_issue")

  @@unique([orgId, id])
  @@index([orgId, projectId, createdOn, seq], map: "Issue_project_createdOn_idx")
}

/// Append-only notes (project manager) and replies (executive reader) on an issue.
model IssueNote {
  id              String       @id @db.Uuid
  orgId           String       @db.Uuid
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  issueId         String       @db.Uuid
  issue           Issue        @relation("IssueNote_issue", fields: [orgId, issueId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  /// 'note' | 'reply' (CHECK constraint in SQL)
  kind            String
  text            String
  onDate          DateTime     @db.Date
  authorAccountId String       @db.Uuid
  authorAccount   LoginAccount @relation("IssueNote_account", fields: [orgId, authorAccountId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  authorPersonId  String       @db.Uuid
  authorPerson    Person       @relation("IssueNote_person", fields: [orgId, authorPersonId], references: [orgId, id], onDelete: Restrict, onUpdate: NoAction)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)

  /// Append order (identity); never the clock.
  seq BigInt @default(autoincrement())

  @@unique([orgId, id])
  @@index([orgId, issueId, seq], map: "IssueNote_issue_idx")
}

