  currentN     Int
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  revisions    ForemanReportRevision[] @relation("ForemanReportRevision_report")

  @@unique([orgId, projectId, id])
  @@unique([orgId, projectId, businessDate, crewId])
}

/// A foreman's claim of quantities (insert-only); rows [{itemKey, qty}], no hours.
