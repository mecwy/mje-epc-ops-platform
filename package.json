{
  "name": "mje-epc-ops-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/publication-policy.test.mjs && vitest run --passWithNoTests",
    "test:integration": "node --env-file=.env scripts/integration.mjs",
    "schema:validate": "prisma validate",
    "schema:format": "prisma format",
    "db:migrate": "prisma migrate deploy",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:public && pnpm schema:validate && pnpm build",
    "test:smoke": "node scripts/smoke.mjs",
    "check:public": "node scripts/check-public.mjs",
    "test:container": "node scripts/container-smoke.mjs"
  },
  "devDependencies": {
    "@azure/storage-blob": "^12.28.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "concurrently": "9.2.1",
    "dotenv": "^17.0.0",
    "eslint": "^10.11.0",
    "globals": "^16.0.0",
    "pg": "^8.16.0",
    "prettier": "^3.6.0",
    "prisma": "7.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
